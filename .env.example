# 私钥配置 (请使用测试私钥，切勿使用包含真实资金的私钥)
PRIVATE_KEY=0xYourPrivateKeyHere

# API Keys
ETHERSCAN_API_KEY=YourEtherscanApiKeyHere
BSCSCAN_API_KEY=YourBSCScanApiKeyHere
ALCHEMY_API_KEY=YourAlchemyApiKeyHere

# RPC URLs - 推荐使用以下可靠的公共端点
BSC_RPC_MAINNET_URL=https://bsc-dataseed.bnbchain.org
BSC_RPC_TESTNET_URL=https://bsc-testnet.drpc.org
# 备用选项：
# BSC_RPC_TESTNET_URL=https://bsc-testnet-rpc.publicnode.com
# BSC_RPC_TESTNET_URL=https://data-seed-prebsc-1-s1.bnbchain.org:8545

# Ethereum RPC URLs (可选)
ETH_MAINNET_RPC_URL=https://eth.llamarpc.com
ETH_SEPOLIA_RPC_URL=https://sepolia.drpc.org

# Gas 配置 (可选)
GAS_PRICE=5000000000
GAS_LIMIT=8000000
